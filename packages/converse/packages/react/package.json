{
  "name": "@laravel/converse-react",
  "version": "0.1.0",
  "description": "Laravel Converse chat hooks and component for React",
  "keywords": [
    "laravel",
    "chat",
    "use-chat",
    "ai",
    "agent",
    "ag-ui",
    "react",
    "hooks"
  ],
  "homepage": "https://github.com/laravel/converse/tree/0.x/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laravel/converse.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/laravel/converse/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Taylor Otwell"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublish": "pnpm run build",
    "release": "vitest --run && pnpm publish --no-git-checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laravel/converse": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
