{
  "name": "@laravel/converse-vue",
  "version": "0.1.0",
  "description": "Laravel Converse chat composable and component for Vue",
  "keywords": [
    "laravel",
    "chat",
    "use-chat",
    "ai",
    "agent",
    "ag-ui",
    "vue",
    "composables"
  ],
  "homepage": "https://github.com/laravel/converse/tree/0.x/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laravel/converse.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/laravel/converse/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Taylor Otwell"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublish": "pnpm run build",
    "release": "vitest --run && pnpm publish --no-git-checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@laravel/converse": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
