{
  "compilerOptions": {
    "target": "ES2020",
    // The emit target stays ES2020; the library is what the checker may read, and the suite uses
    // `toSorted()`, which `unicorn/no-array-sort` requires of it.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
