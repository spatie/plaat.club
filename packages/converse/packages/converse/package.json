{
  "name": "@laravel/converse",
  "version": "0.1.0",
  "description": "Framework-free chat state for Laravel Converse",
  "keywords": [
    "laravel",
    "chat",
    "ai",
    "agent",
    "ag-ui",
    "streaming"
  ],
  "homepage": "https://github.com/laravel/converse/tree/0.x/packages/converse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laravel/converse.git",
    "directory": "packages/converse"
  },
  "bugs": {
    "url": "https://github.com/laravel/converse/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Taylor Otwell"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublish": "pnpm run build",
    "release": "vitest --run && pnpm publish --no-git-checks",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
