{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/converse",
    "description": "Build Slack, Telegram, GitHub, and web chat bots with Laravel.",
    "keywords": ["laravel", "ai", "chat", "bot", "slack", "telegram", "github"],
    "homepage": "https://github.com/laravel/converse",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laravel/converse/issues",
        "source": "https://github.com/laravel/converse"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        },
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com"
        },
        {
            "name": "Pushpak Jadhav",
            "email": "pushpak@laravel.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "guzzlehttp/guzzle": "^7.16.0 || ^8.3.0",
        "illuminate/bus": "^13.38.0",
        "illuminate/console": "^13.38.0",
        "illuminate/contracts": "^13.38.0",
        "illuminate/database": "^13.38.0",
        "illuminate/http": "^13.38.0",
        "illuminate/pipeline": "^13.38.0",
        "illuminate/queue": "^13.38.0",
        "illuminate/routing": "^13.38.0",
        "illuminate/support": "^13.38.0",
        "laravel/ai": "^1.3.0",
        "laravel/prompts": "^0.3.26",
        "nunomaduro/termwind": "^2.4.0",
        "ramsey/uuid": "^4.9.4",
        "symfony/mime": "^7.4.19 || ^8.1.7"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.5.2",
        "larastan/larastan": "^3.13.1",
        "laravel/mcp": "^1.1.1",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^11.3.0",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3",
        "rector/rector": "^2.7.0"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Pages the web chat transcript with Inertia 3 infinite scroll."
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Converse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\Converse\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "rector process",
            "pint --parallel"
        ],
        "test:lint": [
            "rector process --dry-run",
            "pint --test --parallel"
        ],
        "test:types": "phpstan analyse",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --parallel --coverage --min=100.0",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\Converse\\ConverseServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
