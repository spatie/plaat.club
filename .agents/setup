#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v php >/dev/null || ! php -r 'exit(PHP_VERSION_ID >= 80500 ? 0 : 1);'; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq ca-certificates curl unzip
    curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o /tmp/freeks-php-keyring.deb
    sudo dpkg -i /tmp/freeks-php-keyring.deb
    rm /tmp/freeks-php-keyring.deb
    echo 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ bookworm main' | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
    sudo apt-get update -qq
    sudo apt-get install -y -qq php8.5-cli php8.5-sqlite3 php8.5-mbstring php8.5-xml php8.5-curl php8.5-gd php8.5-zip
fi
if ! php -m | grep -qi '^intl$'; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq php8.5-intl
fi
if ! php -m | grep -qi '^pdo_mysql$' || ! dpkg-query -W libaio1 libnuma1 >/dev/null 2>&1; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq php8.5-mysql libaio1 libnuma1
fi
if ! php -m | grep -qi '^pdo_pgsql$' || ! test -x /usr/lib/postgresql/15/bin/postgres; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq php8.5-pgsql postgresql-15 postgresql-client-15
fi
if ! test -f /usr/share/postgresql/15/extension/vector.control; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq build-essential postgresql-server-dev-15
    vector_source="$(mktemp -d)"
    git clone --quiet --depth 1 --branch v0.8.2 https://github.com/pgvector/pgvector.git "$vector_source"
    test "$(git -C "$vector_source" rev-parse HEAD)" = cab9da72c04353f143bb06b42ab70a403daac64a
    make -s -C "$vector_source" -j2
    sudo make -s -C "$vector_source" install
    rm -rf "$vector_source"
fi
postgres_data="$HOME/.local/share/plaat-postgres"
if ! test -f "$postgres_data/PG_VERSION"; then
    mkdir -p "$postgres_data"
    /usr/lib/postgresql/15/bin/initdb -D "$postgres_data" --auth-local=trust --auth-host=trust -U plaat --encoding=UTF8 --locale=C.UTF-8
fi
if ! test -x /opt/mysql/bin/mysqld; then
    curl -fsSL https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-8.4.13-linux-glibc2.28-x86_64-minimal.tar.xz -o /tmp/plaat-mysql.tar.xz
    echo '5dfbb764f731df40ef9e4f5d69aed32bdac8ba1af20bd96b7d40a942d83d4ed2  /tmp/plaat-mysql.tar.xz' | sha256sum -c -
    sudo mkdir -p /opt/mysql
    sudo tar -xJf /tmp/plaat-mysql.tar.xz -C /opt/mysql --strip-components=1
    rm /tmp/plaat-mysql.tar.xz
fi
mysql_data="$HOME/.local/share/plaat-mysql"
mkdir -p "$mysql_data"
if ! test -d "$mysql_data/mysql"; then
    /opt/mysql/bin/mysqld --no-defaults --initialize-insecure --basedir=/opt/mysql --datadir="$mysql_data"
fi
cat > "$mysql_data/init.sql" <<'SQL'
CREATE DATABASE IF NOT EXISTS plaat_club CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS plaat_club_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'plaat'@'127.0.0.1' IDENTIFIED BY '';
GRANT ALL ON plaat_club.* TO 'plaat'@'127.0.0.1';
GRANT ALL ON plaat_club_test.* TO 'plaat'@'127.0.0.1';
SQL
if ! command -v composer >/dev/null; then
    curl -fsSL https://getcomposer.org/installer -o /tmp/freeks-composer.php
    curl -fsSL https://composer.github.io/installer.sig -o /tmp/freeks-composer.sig
    php -r 'if (trim(file_get_contents("/tmp/freeks-composer.sig")) !== hash_file("sha384", "/tmp/freeks-composer.php")) exit(1);'
    php /tmp/freeks-composer.php --install-dir=/tmp --filename=freeks-composer
    sudo mv /tmp/freeks-composer /usr/local/bin/composer
    rm /tmp/freeks-composer.php /tmp/freeks-composer.sig
fi
if ! command -v mailpit >/dev/null; then
    curl -fsSL https://github.com/axllent/mailpit/releases/download/v1.31.6/mailpit-linux-amd64.tar.gz -o /tmp/freeks-mailpit.tar.gz
    tar -xzf /tmp/freeks-mailpit.tar.gz -C /tmp mailpit
    sudo install /tmp/mailpit /usr/local/bin/mailpit
    rm /tmp/mailpit /tmp/freeks-mailpit.tar.gz
fi
composer install --no-interaction --prefer-dist
if ! test -f .env; then
    cp .env.example .env
    sed -i 's/^DB_CONNECTION=sqlite$/DB_CONNECTION=mysql/' .env
    cat >> .env <<'ENV'

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plaat_club
DB_USERNAME=plaat
DB_PASSWORD=
ENV
fi
if ! rg -q '^APP_KEY=base64:' .env; then php artisan key:generate; fi
test -f database/database.sqlite || touch database/database.sqlite
amp orb services ensure
for database in plaat_club plaat_club_test; do
    if ! psql -h 127.0.0.1 -U plaat -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '$database'" | grep -q 1; then
        createdb -h 127.0.0.1 -U plaat "$database"
    fi
done
php artisan migrate --force
npm ci --no-audit --no-fund
npm run build
test -L public/storage || php artisan storage:link
# Synthetic demo data is opt-in: php artisan social:seed-demo
